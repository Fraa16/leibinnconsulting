# Calendly scheduling link for the booking card (#termin), e.g.
# https://calendly.com/<account>/erstgespraech
# Leave empty to show the design's mock calendar.
VITE_CALENDLY_URL=

# Central lead service (consent log, bookings), e.g. https://leads.leibinn-consulting.de
VITE_LEADS_API_URL=

# Ad tracking, loaded only after consent. Empty = not loaded.
VITE_META_PIXEL_ID=
VITE_LINKEDIN_PARTNER_ID=
VITE_LINKEDIN_CONVERSION_LEAD=
VITE_LINKEDIN_CONVERSION_BOOKING=
# Optional Google services: appear in the cookie banner and the privacy policy
# only once set, and load only after consent. GA4 = G-…, Google Ads = AW-…
VITE_GA4_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_LABEL_LEAD=
VITE_GOOGLE_ADS_LABEL_BOOKING=
