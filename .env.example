# Copy to .env for local development, and set the same values in
# Vercel → Settings → Environment Variables for production.
#
# These are read server-side only (api/lead.ts). They are never bundled into the
# client — do not prefix them with VITE_, which would expose them to the browser.
#
# With these unset the contact forms still validate and submit; the lead is
# written to the server log instead of emailed, and the success panel says so.

# API key from https://resend.com
RESEND_API_KEY=

# Where enquiries should arrive
LEAD_TO_EMAIL=

# Sender address, on a domain verified in Resend
LEAD_FROM_EMAIL=
